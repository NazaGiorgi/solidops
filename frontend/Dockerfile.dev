# =============================================================================
# Frontend Dockerfile.dev — LOCAL DEVELOPMENT (hot reload)
# node_modules is a named volume in docker-compose.dev.yml.
# =============================================================================
FROM node:20-alpine

WORKDIR /app

COPY package.json ./
COPY package-lock.json* ./
RUN npm install --no-audit --no-fund

COPY . .

EXPOSE 3000
CMD ["npm", "run", "dev"]
