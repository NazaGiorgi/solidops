# =============================================================================
# Backend env (echo of root .env, split by scope). Copy to backend/.env in
# dev or use the compose env_file. The compose file already maps these.
# Keep this in sync with src/config/configuration.ts
# =============================================================================
PORT=4000
NODE_ENV=development

DB_HOST=postgres
DB_PORT=5432
DB_USER=ops
DB_PASSWORD=ops_dev_password
DB_NAME=ops_msp

REDIS_HOST=redis
REDIS_PORT=6379

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev
MINIO_BUCKET=ops-msp

JWT_SECRET=change-me-dev-jwt-secret
JWT_REFRESH_SECRET=change-me-dev-jwt-refresh-secret
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# Derives the AES-256 key that encrypts mailbox credentials.
ENCRYPTION_SECRET=change-me-dev-encryption-secret

# Zammad's application_secret ("pepper") used to hash its passwords with
# Argon2id. Required ONLY if you imported Zammad users and want the lazy
# Argon2->bcrypt migration to verify their passwords. Set the real value
# (echoed by `zammad run rails runner "puts Setting.get('application_secret')"`).
# Leave empty if you are not migrating Zammad accounts.
ZAMMAD_APPLICATION_SECRET=

CORS_ORIGINS=http://localhost:3000

RUN_SEED=true
