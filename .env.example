# =============================================================================
# Shared environment (values here are DEV defaults; prod uses .env.prod)
# Copy this file to `.env` for local development.
# NEVER commit the real `.env` or `.env.prod` files.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops_dev_password
POSTGRES_DB=ops_msp
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Backend API ---
BACKEND_PORT=4000
# Comma-separated list of allowed CORS origins (the browser frontend URLs)
CORS_ORIGINS=http://localhost:3000

# Secrets (generate real random values in production)
JWT_SECRET=change-me-dev-jwt-secret
JWT_REFRESH_SECRET=change-me-dev-jwt-refresh-secret
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
# Duraci贸n extendida SOLO para tokens de scripts administrativos (migraci贸n, etc.).
# Se usa 煤nicamente cuando el login pide `purpose: "admin"` y el usuario es
# Administrador. La sesi贸n normal del navegador sigue usando JWT_EXPIRES_IN.
JWT_ADMIN_EXPIRES_IN=7200

# Key used to derive the AES-256 key that encrypts mailbox credentials.
# MUST be a long random string (>=16 chars). Different from JWT_SECRET in prod.
ENCRYPTION_SECRET=change-me-dev-encryption-secret

# Servicio de conversi贸n Office->PDF (LibreOffice headless) para la vista previa
# de documentos. Host/port interno del servicio `lo-converter` en el compose.
# Se usa solo internamente (no se expone). Vac铆o desactiva la conversi贸n de Office.
LO_CONVERTER_URL=http://lo-converter:8000
# Timeout (ms) m谩ximo para la conversi贸n Office->PDF de un documento. Si
# LibreOffice se cuelga (docx complejo/corrupto), se aborta y se muestra el
# mensaje "no se pudo previsualizar" en vez de colgarse. Default 60000.
LO_CONVERTER_TIMEOUT_MS=60000

# Zammad's application_secret ("pepper") used to hash passwords with Argon2id.
# Required ONLY if importing Zammad users and you want the lazy Argon2->bcrypt
# migration to verify their passwords. Get it with:
#   zammad run rails runner "puts Setting.get('application_secret')"
# Leave empty if you are not migrating Zammad accounts.
ZAMMAD_APPLICATION_SECRET=

# --- Frontend ---
FRONTEND_PORT=3000
# Public URL of the backend API that the frontend calls
NEXT_PUBLIC_API_URL=http://localhost:4000
# Internal service URL used during server-side rendering / server components
NEXT_PUBLIC_INTERNAL_API_URL=http://backend:4000

# --- Seed ---
# Set to "true" to run the automated seed once on first healthy boot
RUN_SEED=true


# --- WhatsApp Cloud API (webhook + env韔) ---
# Token del System User (permanente, NO el temporal de 24 hs). Vac韔 en dev: el
# env韔 se omite con WARN y la verificaci髇 de firma se salta.
WHATSAPP_ACCESS_TOKEN=
# Phone Number ID del n鷐ero real en producci髇.
WHATSAPP_PHONE_NUMBER_ID=
# String arbitrario que el proyecto define; Meta lo usa para verificar el webhook.
WHATSAPP_VERIFY_TOKEN=dev-verify-token
# App Secret de la app de Meta, para verificar la firma X-Hub-Signature-256.
WHATSAPP_APP_SECRET=

# Secreto compartido exigido por POST /api/email/inbound (header X-Inbound-Secret).
# El worker IMAP ingiere emails en proceso y no usa esta ruta HTTP.
INBOUND_EMAIL_SECRET=
